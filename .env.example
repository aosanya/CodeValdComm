# CodeValdComm — environment configuration example.
# Copy this file to .env and fill in the values for your environment.
# The .env file is gitignored and must never be committed.

# -------------------------------------------------------------------
# CodeValdCross integration
# -------------------------------------------------------------------

# gRPC address of the CodeValdCross orchestrator.
# When set, CodeValdComm calls Register on startup to announce itself.
# Leave unset to run CodeValdComm in standalone mode (no registration).
# CROSS_GRPC_ADDR=:50051

# How often CodeValdComm re-registers with CodeValdCross (heartbeat).
# Accepts Go duration strings (e.g. 20s, 1m). Set to 0 to disable.
# CROSS_PING_INTERVAL=20s

# Per-RPC timeout for each Register call.
# CROSS_PING_TIMEOUT=5s

# Address that CodeValdCross will use to dial back into this service.
# Defaults to the listen address. Override in multi-host deployments.
# COMM_GRPC_ADVERTISE_ADDR=:50057

# Agency this CodeValdComm instance is scoped to.
# Included in every Register heartbeat and used for startup schema seed.
# Leave unset for instances that serve all agencies.
# CODEVALDCOMM_AGENCY_ID=utility-app-builder

# -------------------------------------------------------------------
# Inbound gRPC / HTTP server
# -------------------------------------------------------------------

# TCP port the CodeValdComm server listens on (gRPC + HTTP via cmux).
# Default: 50057
CODEVALDCOMM_GRPC_PORT=50057

# -------------------------------------------------------------------
# ArangoDB backend
# -------------------------------------------------------------------

# ArangoDB server endpoint.
# COMM_ARANGO_ENDPOINT=http://localhost:8529

# Database name for CodeValdComm collections.
# COMM_ARANGO_DATABASE=codevaldcomm

# Database used exclusively by integration tests (make test-arango).
# A single persistent database is shared across test runs; tests use
# unique agency IDs to avoid inter-test data pollution.
# COMM_ARANGO_DATABASE_TEST=codevaldcomm_tests

# ArangoDB credentials.
# COMM_ARANGO_USER=root
# COMM_ARANGO_PASSWORD=
