# syntax=docker/dockerfile:1
#
# Build context MUST be the monorepo root so the COPY lines can reach
# CodeValdSharedLib/ — go.mod has `replace ... => ../CodeValdSharedLib`,
# which only resolves when SharedLib is present on disk at build time.
#
# Invoked from Deployment/staging/codevaldcomm/Makefile as:
#   docker build -f ../../../CodeValdComm/Dockerfile.server -t codevaldcomm:staging ../../..

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS build

WORKDIR /src

# SharedLib first — referenced via `replace` in CodeValdComm/go.mod.
# Copied to /CodeValdSharedLib so that `../CodeValdSharedLib` resolves from /src.
COPY CodeValdSharedLib/ /CodeValdSharedLib/

# Cache dependency downloads separately from source changes.
COPY CodeValdComm/go.mod CodeValdComm/go.sum ./
RUN go mod download

# Copy the rest of the source and build the server binary.
COPY CodeValdComm/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /codevaldcomm-server ./cmd/server

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12

COPY --from=build /codevaldcomm-server /codevaldcomm-server

# gRPC + HTTP port (cmux)
EXPOSE 50057

ENTRYPOINT ["/codevaldcomm-server"]
